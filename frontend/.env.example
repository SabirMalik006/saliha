VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_WITH_CREDENTIALS=true
# Set to false to talk to the real backend in ../backend instead of the
# in-browser mock API. See backend/README.md for setup.
VITE_USE_MOCK_API=true
VITE_SITE_URL=

# Google Analytics 4 measurement ID (spec FUN-09).
# Leave EMPTY until the clinic supplies a real property. While empty no
# third-party analytics script is loaded and all tracking calls are no-ops,
# so there is no privacy or performance cost during development.
# Example once supplied: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=