# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server and preview server are included by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Database (MongoDB)  -> paste your connection string here
# ---------------------------------------------------------------------------
# Local example:  mongodb://127.0.0.1:27017/specialist-clinic
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/specialist-clinic
MONGODB_URI=

# ---------------------------------------------------------------------------
# Sessions (JWT stored in an HttpOnly cookie)
# ---------------------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=sc_session
# lax works for localhost. Use "none" (requires HTTPS) when the API and the
# website live on different domains in production.
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Cloudinary (image storage) -> paste your keys here
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=specialist-clinic
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Seed admin account (used by `npm run seed` and the first boot)
# ---------------------------------------------------------------------------
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@specialistclinic.com
ADMIN_PASSWORD=ChangeMe123!
